# H5 proxies /api to https://melco1.weprogram.site; native builds use that origin directly.
VITE_DEV_SERVER_HOST=0.0.0.0

# WINSON-DEVIATION: set true only for an explicitly labeled demo build using a temporary driver phone number.
VITE_USE_MOCK_DRIVER_PHONE=false

# User-approved service contact defaults; set deployment-specific numbers if needed.
VITE_SUPPORT_PHONE_NUMBER=+8613700000000
VITE_OPERATIONS_PHONE_NUMBER=+8613900000000

# AMap settings are shared with LMS-DriverApp in ../.env.local (see ../.env.example).
