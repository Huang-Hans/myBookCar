{
  "name": "lms-driver-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:h5": "uni",
    "local:h5": "uni --mode localhost",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:android-apk": "npm run build:h5 && node scripts/build-android-apk.cjs",
    "build:app-harmony": "uni build -p app-harmony",
    "build:harmony-native": "npm run build:app-harmony && node scripts/build-harmony-native.cjs",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && node ../scripts/verify-app-icons.cjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-harmony": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@microsoft/signalr": "^8.0.7",
    "leaflet": "^1.9.4",
    "pinia": "2.3.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^29.1.1",
    "sass": "^1.77.8",
    "typescript": "^5.8.3",
    "vite": "5.2.8",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.10"
  }
}
