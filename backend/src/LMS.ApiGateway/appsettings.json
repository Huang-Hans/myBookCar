{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Login": {
    "TokenEndpoint": "",
    "ClientId": "lms-api-client",
    "TimeoutSeconds": 10
  },
  "Platform": {
