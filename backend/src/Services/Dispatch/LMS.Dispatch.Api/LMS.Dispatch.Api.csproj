<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>7a2d4c1e-3f5b-4e68-9c0a-2b8d6e4f1a93</UserSecretsId>
    <!-- 输出 XML 注释供 Swagger 展示接口与契约说明。
         1591：不强制为每个公开成员写注释；1573：动作只在契约参数上写 param，CancellationToken 不参与文档。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.11" />
  </ItemGroup>

  <!-- Do not expose the abandoned model-selection controller. -->
  <ItemGroup>
    <Compile Remove="Controllers\InternalVehicleModelsController.cs" />
    <None Include="Controllers\InternalVehicleModelsController.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\LMS.ServiceDefaults\LMS.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\LMS.BuildingBlocks.Identity\LMS.BuildingBlocks.Identity.csproj" />
    <ProjectReference Include="..\..\..\LMS.BuildingBlocks.Realtime\LMS.BuildingBlocks.Realtime.csproj" />
    <ProjectReference Include="..\LMS.Dispatch.Application\LMS.Dispatch.Application.csproj" />
    <ProjectReference Include="..\LMS.Dispatch.Infrastructure\LMS.Dispatch.Infrastructure.csproj" />
  </ItemGroup>

</Project>
