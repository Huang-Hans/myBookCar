<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>e1b7f3a4-5c28-4d9e-8a60-7f2d1c9b3e54</UserSecretsId>
    <!-- 输出 XML 注释供 Swagger 展示接口与契约说明。
         1591：不强制为每个公开成员写注释；1573：动作只在契约参数上写 param，CancellationToken 不参与文档。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\LMS.ServiceDefaults\LMS.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\LMS.BuildingBlocks.Identity\LMS.BuildingBlocks.Identity.csproj" />
    <ProjectReference Include="..\..\..\LMS.BuildingBlocks.Realtime\LMS.BuildingBlocks.Realtime.csproj" />
    <ProjectReference Include="..\LMS.Booking.Application\LMS.Booking.Application.csproj" />
    <ProjectReference Include="..\LMS.Booking.Infrastructure\LMS.Booking.Infrastructure.csproj" />
  </ItemGroup>

</Project>
