# Copy this file to .env on the deployment host. Never commit real keys or secrets.

# Booking-to-Platform service identity is configured in each service's appsettings.json:
# Booking ServiceSigning:PrivateKeyPem; Platform ServiceIdentity:PublicKeyPem.
# Configure matching Issuer, Audience and KeyId in those same settings sections.

# AMap keys baked into the client / driver H5 bundles at build time.
# The key needs both JS API and Web Service enabled, and must be restricted to the
# frontend domains (it is public once bundled). Leave empty to show "AMap is not configured".
AMAP_WEB_KEY=
# 仅 2021-12-02 之后创建的 JS API key 需要；旧 key 留空即可（留空时前端走静态瓦片图渲染）。
AMAP_SECURITY_JS_CODE=
